<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodbooking.controller.OrderViewDialogController" prefWidth="700" prefHeight="600">
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <Label text="Užsakymo informacija" style="-fx-font-weight: bold; -fx-font-size: 18;"/>

            <!-- Order Details -->
            <GridPane hgap="10" vgap="10">
                <Label text="Užsakymo ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="orderIdLabel" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Klientas:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <Label fx:id="clientLabel" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Restoranas:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="restaurantLabel" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Vairuotojas:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <Label fx:id="driverLabel" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Statusas:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <Label fx:id="statusLabel" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Pristatymo adresas:" GridPane.columnIndex="0" GridPane.rowIndex="5" style="-fx-font-weight: bold;"/>
                <Label fx:id="addressLabel" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Pastabos:" GridPane.columnIndex="0" GridPane.rowIndex="6" style="-fx-font-weight: bold;"/>
                <Label fx:id="notesLabel" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Sukurta:" GridPane.columnIndex="0" GridPane.rowIndex="7" style="-fx-font-weight: bold;"/>
                <Label fx:id="createdLabel" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>

            <Separator/>

            <!-- Order Items -->
            <Label text="Užsakymo elementai:" style="-fx-font-weight: bold; -fx-font-size: 14;"/>

            <TableView fx:id="orderItemsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="itemNameColumn" text="Pavadinimas" prefWidth="250"/>
                    <TableColumn fx:id="itemPriceColumn" text="Kaina (€)" prefWidth="100"/>
                    <TableColumn fx:id="itemQuantityColumn" text="Kiekis" prefWidth="100"/>
                    <TableColumn fx:id="itemSubtotalColumn" text="Suma (€)" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label text="Bendra suma:" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
                <Label fx:id="totalLabel" style="-fx-font-weight: bold; -fx-font-size: 16;"/>
            </HBox>

            <!-- Buttons -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Uždaryti" onAction="#handleClose" prefWidth="100" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
