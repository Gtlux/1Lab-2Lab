<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodbooking.controller.MenuItemsTabController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Title and Buttons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Meniu valdymas" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Pridėti naują" onAction="#handleAdd" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button fx:id="editButton" text="Redaguoti" onAction="#handleEdit" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button fx:id="deleteButton" text="Ištrinti" onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        <Button fx:id="addToCartButton" text="🛒 Į krepšelį" onAction="#handleAddToCart" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14;" managed="false" visible="false"/>
        <Button text="Atnaujinti" onAction="#handleRefresh" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
    </HBox>

    <!-- Filter Section -->
    <VBox spacing="10">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Filtruoti:"/>
            <Label text="Restoranas:"/>
            <ComboBox fx:id="restaurantFilterComboBox" promptText="Visi" prefWidth="150"/>
            <Label text="Kategorija:"/>
            <ComboBox fx:id="categoryFilterComboBox" promptText="Visos" prefWidth="120"/>
            <Label text="Prieinamumas:"/>
            <ComboBox fx:id="availabilityFilterComboBox" promptText="Visi" prefWidth="100"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Pavadinimas:"/>
            <TextField fx:id="nameFilterField" promptText="Ieškoti..." prefWidth="150"/>
            <Label text="Kaina nuo:"/>
            <TextField fx:id="minPriceField" promptText="0.00" prefWidth="80"/>
            <Label text="iki:"/>
            <TextField fx:id="maxPriceField" promptText="999.99" prefWidth="80"/>
            <Button text="Taikyti filtrus" onAction="#handleFilter" style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
            <Button text="Išvalyti" onAction="#handleClearFilter" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
        </HBox>
    </VBox>

    <!-- Table -->
    <TableView fx:id="menuItemsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nameColumn" text="Pavadinimas" prefWidth="150"/>
            <TableColumn fx:id="descriptionColumn" text="Aprašymas" prefWidth="200"/>
            <TableColumn fx:id="priceColumn" text="Kaina (€)" prefWidth="100"/>
            <TableColumn fx:id="categoryColumn" text="Kategorija" prefWidth="120"/>
            <TableColumn fx:id="restaurantColumn" text="Restoranas" prefWidth="150"/>
            <TableColumn fx:id="availableColumn" text="Prieinamas" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
