<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodbooking.controller.LoginController">
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f5f5f5;">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40"/>
            </padding>

            <!-- Title -->
            <Label text="Maisto Rezervavimo Sistema" styleClass="title">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>

            <!-- Login Form -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" maxWidth="400">

                <Label text="Prisijungimas">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>

                <!-- Username -->
                <VBox spacing="5">
                    <Label text="Vartotojo vardas:"/>
                    <TextField fx:id="usernameField" promptText="Įveskite vartotojo vardą" prefHeight="35"/>
                </VBox>

                <!-- Password -->
                <VBox spacing="5">
                    <Label text="Slaptažodis:"/>
                    <PasswordField fx:id="passwordField" promptText="Įveskite slaptažodį" prefHeight="35"/>
                </VBox>

                <!-- Buttons -->
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Prisijungti" onAction="#handleLogin" prefWidth="120" prefHeight="35" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Registruotis" onAction="#handleRegister" prefWidth="120" prefHeight="35" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <!-- Test Credentials Info -->
                <VBox spacing="5" style="-fx-padding: 10; -fx-background-color: #e3f2fd; -fx-background-radius: 5;">
                    <Label text="Testiniai prisijungimai:" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
                    <Label text="Admin: admin / password123" style="-fx-font-size: 11;"/>
                    <Label text="Savininkas: owner1 / password123" style="-fx-font-size: 11;"/>
                    <Label text="Vairuotojas: driver1 / password123" style="-fx-font-size: 11;"/>
                    <Label text="Klientas: client1 / password123" style="-fx-font-size: 11;"/>
                </VBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
