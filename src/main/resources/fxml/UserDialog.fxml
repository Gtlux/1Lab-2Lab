<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodbooking.controller.UserDialogController" spacing="15" style="-fx-padding: 20;">

    <!-- Username -->
    <VBox spacing="5">
        <Label text="Vartotojo vardas: *"/>
        <TextField fx:id="usernameField" promptText="Įveskite vartotojo vardą"/>
    </VBox>

    <!-- Password -->
    <VBox spacing="5">
        <Label text="Slaptažodis: *"/>
        <PasswordField fx:id="passwordField" promptText="Įveskite slaptažodį"/>
    </VBox>

    <!-- Email -->
    <VBox spacing="5">
        <Label text="El. paštas: *"/>
        <TextField fx:id="emailField" promptText="Įveskite el. paštą"/>
    </VBox>

    <!-- Full Name -->
    <VBox spacing="5">
        <Label text="Pilnas vardas: *"/>
        <TextField fx:id="fullNameField" promptText="Įveskite pilną vardą"/>
    </VBox>

    <!-- Phone -->
    <VBox spacing="5">
        <Label text="Telefono numeris: *"/>
        <TextField fx:id="phoneField" promptText="+370..."/>
    </VBox>

    <!-- Role -->
    <VBox spacing="5">
        <Label text="Rolė: *"/>
        <ComboBox fx:id="roleComboBox" promptText="Pasirinkite rolę" maxWidth="Infinity"/>
    </VBox>

    <!-- Restaurant (conditional) -->
    <VBox fx:id="restaurantBox" spacing="5" managed="false" visible="false">
        <Label text="Restoranas:"/>
        <ComboBox fx:id="restaurantComboBox" promptText="Pasirinkite restoraną" maxWidth="Infinity"/>
    </VBox>

    <!-- Active -->
    <CheckBox fx:id="activeCheckBox" text="Aktyvus" selected="true"/>

    <!-- Buttons -->
    <HBox spacing="10" alignment="CENTER">
        <Button text="Išsaugoti" onAction="#handleSave" prefWidth="100" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Atšaukti" onAction="#handleCancel" prefWidth="100" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
    </HBox>
</VBox>
