<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodbooking.controller.OrdersTabController" spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <!-- Title and Buttons -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Užsakymų valdymas" style="-fx-font-size: 18; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="Naujas užsakymas" onAction="#handleAdd" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Peržiūrėti" onAction="#handleView" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button fx:id="changeStatusButton" text="Keisti statusą" onAction="#handleChangeStatus" style="-fx-background-color: #FF9800; -fx-text-fill: white;"/>
        <Button fx:id="assignDriverButton" text="Priskirti vairuotoją" onAction="#handleAssignDriver" style="-fx-background-color: #673AB7; -fx-text-fill: white;" managed="false" visible="false"/>
        <Button fx:id="requestCancellationButton" text="Prašyti atšaukti" onAction="#handleRequestCancellation" style="-fx-background-color: #9C27B0; -fx-text-fill: white;" managed="false" visible="false"/>
        <Button fx:id="deleteButton" text="Ištrinti" onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        <Button text="Atnaujinti" onAction="#handleRefresh" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
    </HBox>

    <!-- Filter Section -->
    <VBox spacing="5">
        <Label text="Filtravimas (Status, Laikas, Klientas, Restoranas):" style="-fx-font-weight: bold;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Statusas:"/>
            <ComboBox fx:id="statusFilterComboBox" promptText="Visi statusai" prefWidth="150"/>
            <Label text="Restoranas:"/>
            <ComboBox fx:id="restaurantFilterComboBox" promptText="Visi restoranai" prefWidth="150"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Klientas (vardas):"/>
            <TextField fx:id="clientNameFilterField" promptText="Kliento vardas" prefWidth="150"/>
            <Label text="Data nuo:"/>
            <DatePicker fx:id="dateFromPicker" prefWidth="150"/>
            <Label text="Data iki:"/>
            <DatePicker fx:id="dateToPicker" prefWidth="150"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Taikyti filtrą" onAction="#handleFilterOrders" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Išvalyti filtrą" onAction="#handleClearFilterOrders" style="-fx-background-color: #9E9E9E; -fx-text-fill: white;"/>
            <Label fx:id="orderFilterResultLabel" text="" style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Table -->
    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="clientColumn" text="Klientas" prefWidth="120"/>
            <TableColumn fx:id="restaurantColumn" text="Restoranas" prefWidth="120"/>
            <TableColumn fx:id="driverColumn" text="Vairuotojas" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Statusas" prefWidth="120"/>
            <TableColumn fx:id="totalAmountColumn" text="Suma (€)" prefWidth="100"/>
            <TableColumn fx:id="deliveryAddressColumn" text="Pristatymo adresas" prefWidth="200"/>
            <TableColumn fx:id="createdAtColumn" text="Sukurta" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
